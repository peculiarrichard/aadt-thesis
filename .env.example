POSTGRES_USER=addt
POSTGRES_PASSWORD=addt_dev_password
POSTGRES_DB=addt
# Not 5432: some dev machines have a native (non-Docker) Postgres also bound to 5432
# on the host, which silently intercepts host-side tools (alembic, etc.) even though
# `docker compose exec` still works (that connects from inside the container's own
# network namespace). Pick whatever's actually free on your machine -- 5433 is a
# common second choice but may itself be taken by another project's Docker Postgres.
POSTGRES_PORT=5434
# Host the backend uses to reach the db container from the host machine (not read by docker-compose itself).
POSTGRES_HOST=localhost

# Shared secret the intake tooling must present to the ingestion API.
# Change this before the API is reachable from anywhere but localhost.
INGESTION_API_KEY=dev-only-change-me

# LLM inference (Section 8). Dev default: local Ollama. Prod: vLLM+AWQ --
# config-only swap, no code change.
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3.1:8b
LLM_API_KEY=ollama

# Google OAuth (per-clinician console login). Create these in Google Cloud
# Console: OAuth consent screen + a Web application OAuth client, with
# GOOGLE_OAUTH_REDIRECT_URI below added as an authorized redirect URI.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/auth/google/callback
# The frontend's real origin -- both the post-login redirect target and the
# CORS-allowed origin (main.py). Must match where `npm run dev` actually binds
# (vite.config.ts pins it to 5173 via strictPort so it can't silently drift).
FRONTEND_URL=http://localhost:5173
# Random 32+ char string signing the console's session cookie. Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET_KEY=dev-only-change-me

# The pilot doctor's real Google account email. Set before her first login so
# it claims the walkthrough-imported clinician row (and her real cases)
# instead of creating a separate, case-less one. A second doctor onboarded
# self-service doesn't need this -- her Google login creates her own
# clinician row directly.
WALKTHROUGH_CLINICIAN_EMAIL=

# Phase J: system-wide gate on any real-patient-related action (recording a
# live consultation, uploading a de-identified case). Not per-clinician, not
# exposed in any UI -- set this only once your university's IRB/ethics
# clearance actually exists. A doctor's own consent is necessary but never
# sufficient on its own; this must also be true.
INSTITUTIONAL_ETHICS_CLEARANCE_GRANTED=false

# Phase N: minimum qualifying cases (walkthrough, elicitation, or
# de-identified real-consultation) before a clinician can build her twin.
MIN_CASES_TO_BUILD_TWIN=20
